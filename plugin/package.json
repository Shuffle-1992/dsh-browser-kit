{
  "name": "dsh-browser-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./entry.mjs",
    "./client": "./client.js",
    "./typert": "./wire.host.mjs",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "meta": {
    "title": "DSH 浏览器增强套件",
    "description": "给 DSH 内置浏览器加编码助手协作能力：元素批注（多窗口共享会话、编号跨窗口延续、提交合并落盘）、截图回传（agent 可直接读图）、设备通讯观测（HID/Serial/USB）与一条由实施会话驱动的命令通道。"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "license": "SEE LICENSE IN NOTICE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuffle-1992/dsh-browser-kit.git"
  },
  "homepage": "https://github.com/Shuffle-1992/dsh-browser-kit",
  "bugs": {
    "url": "https://github.com/Shuffle-1992/dsh-browser-kit/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "deepseek",
    "harness",
    "browser",
    "annotation",
    "playwright-alternative",
    "plugin"
  ]
}
